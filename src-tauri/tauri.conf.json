{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caption Salience",
  "version": "0.1.0",
  "identifier": "in.sociobot.caption-salience",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:site",
    "frontendDist": "../dist/site"
  },
  "app": {
    "windows": [{
      "title": "Caption Salience",
      "width": 1180,
      "height": 780,
      "minWidth": 390,
      "minHeight": 620
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Make uncertain caption words easier to notice.",
    "longDescription": "A local caption player for SRT and WebVTT files with accessible emphasis controls."
  }
}
